
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read their own document and cannot write to it from the client.
    match /Users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; 
    }

    // Users can create transactions, and read transactions where they are the sender or receiver.
    match /Transactions/{transactionId} {
      allow read: if request.auth != null && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if false;
    }

    // Users can create their own withdrawal requests and read them. Admins can update.
    match /Withdrawals/{withdrawalId} {
      allow read, create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // In a real app, you'd have an admin role check here for updates.
      allow update: if false; // For now, prevent client-side updates.
      allow delete: if false;
    }
  }
}
