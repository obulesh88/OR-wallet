
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Users can read and update their own profile document.
      allow read, update: if isOwner(userId);

      // Users can create their own profile document if the UID matches.
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;

      // Rules for the 'transactions' subcollection
      match /transactions/{transactionId} {
        // Users can read and write (create, update, delete) their own individual transaction documents.
        allow read, write: if isOwner(userId);
      }
      
      // Explicitly allow users to list their own transactions. This is required for collection queries.
      allow list: if isOwner(userId);
    }
  }
}
