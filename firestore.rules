rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - stores user profiles and balances
    match /users/{userId} {
      // Users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users can create their profile during signup
      allow create: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.resource.data.balance == 0 &&
                      request.resource.data.oraBalance == 0 &&
                      request.resource.data.createdAt == request.time;
      
      // Users can update only specific fields, balance is updated via transactions
      allow update: if request.auth != null && 
                      request.auth.uid == userId &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance', 'oraBalance']) &&
                      request.resource.data.lastUpdated == request.time;
    }
    
    // Transactions collection - stores all coin transactions
    match /transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if request.auth != null && 
                    resource.data.userId == request.auth.uid;
      
      // Create transaction rules
      allow create: if request.auth != null && 
                      // User can only create transactions for themselves
                      request.resource.data.userId == request.auth.uid &&
                      // Required fields
                      request.resource.data.keys().hasAll(['type', 'amount', 'status', 'date', 'description']) &&
                      // Amount must be a number
                      request.resource.data.amount is number &&
                      // Type must be valid
                      request.resource.data.type in ['earn', 'convert'] &&
                      // Timestamp validation
                      request.resource.data.date == request.time;
    }
    
    // Admin functions - separate admin collection
    match /admin/{document=**} {
      allow read, write: if request.auth != null && 
                           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
